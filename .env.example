# TikTok Developer App Credentials (Content Posting API / Login Kit)
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback

# TikTok Shop Partner Credentials (for future Phase)
TIKTOK_SHOP_APP_KEY=your_tiktok_shop_app_key_here
TIKTOK_SHOP_APP_SECRET=your_tiktok_shop_app_secret_here
TIKTOK_SHOP_REDIRECT_URI=http://localhost:3000/api/tiktok-shop/callback

# Application Base URL
APP_URL=http://localhost:3000
# Optional custom production domains allowed to call the local Google Vids bridge.
# Vercel preview/production *.vercel.app domains are already accepted.
AFF_PRODUCTION_ORIGINS=https://your-custom-domain.example

# Google Gemini API Key (Real Product Analysis & Storyboard Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# TikTok Shop Production Scraping Proxy (Choose ONE option to bypass Akamai bot check on Vercel):
# Option A (100% Free): Cloudflare Worker Proxy URL (scripts/cloudflare-tiktok-proxy.js)
TIKTOK_SCRAPE_PROXY_URL=https://your-worker-subdomain.workers.dev
# Option B (1000 free req/mo): ScraperAPI key
SCRAPER_API_KEY=your_scraperapi_key_here

# ElevenLabs API Key (Ultra-realistic Human Voiceover for TikTok)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_DEFAULT_VOICE_ID=your_elevenlabs_voice_id_here

# Vibi TTS API (supports ElevenLabs, MiniMax and CapCut voices through Vibi)
VIBI_API_KEY=your_vibi_api_key_here
VIBI_DEFAULT_VOICE_ID=your_vibi_voice_id_here
# Separate CapCut voice ID so the UI can switch engines without changing env values.
VIBI_CAPCUT_VOICE_ID=your_vibi_capcut_voice_id_here
VIBI_UPSTREAM_PROVIDER=elevenlabs
VIBI_MODEL_ID=eleven_v4

# Product context images: Cloudflare Workers AI (keep Workers Free)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
